{
  "name": "kando-global-project",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": "^22.23.4"
  },
  "scripts": {
    "build": "turbo build",
    "type-check": "turbo type-check",
    "lint": "node scripts/check-dep-direction.mjs",
    "test:app-compatibility": "node scripts/check-app-compatibility.mjs",
    "app:chrome:dev": "cd apps/flutter-app && flutter run -d chrome --web-port=3000 --dart-define-from-file=config/test.json",
    "app:chrome:prod": "cd apps/flutter-app && flutter run -d chrome --web-port=3000 --dart-define-from-file=config/production.json"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
