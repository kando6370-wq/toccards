    "conclusions": [
      {
        "id": "6c639d96-dae9-4a62-9f2b-08fabbfc484e",
        "status": "PROVEN",
        "text": "当前表必须保留 product_id/card_ref、SKU/PriceCharting 来源标识、condition/language/variant、9 类价格指标及对应涨幅的业务信息；评级 bucket 存在范围语义，例如 7/7.5。",
        "evidence": [
          "apps/workers-api/src/db/schema.ts:97-147",
          "apps/workers-api/src/data-source/local-db-adapter.ts:80-97"
        ]
      },
      {
        "id": "9aa6fdbd-23f8-498b-980a-411b87497c10",
        "status": "PROPOSAL",
        "text": "目标价格域使用 price_source、price_series、price_ingest_batch、price_current_snapshot、current_price_pointer、price_history_month、card_trending_snapshot 七表；price_series 用 grade_min/grade_max 表达评级区间，金额使用 bigint micros，日期使用 date/timestamptz。",
        "evidence": [
          "字段来自当前 schema、查询契约、完整批次可见性和金额非浮点要求"
        ]
      },
      {
        "id": "858b7c8d-e46f-4861-802d-b0fed20038e7",
        "status": "PROPOSAL",
        "text": "价格历史基线采用按月 jsonb 且不建 GIN；仅当真实源数据证明每天每序列最多一个价格点时，对照压测 smallint[] 日期数组与 bigint[] 金额数组。",
        "evidence": [
          "当前 API 只整段读取价格点，不执行 JSON 内条件检索；外部导入器不在仓库"
        ]
      },
      {
        "id": "344e2a2c-236b-42e5-bdf9-c61a3d969ae8",
        "status": "UNKNOWN",
        "text": "金额最大小数位、单日是否唯一、历史修订是否要求批次原子可见、source key 的正式生成规则仍未确认。",
        "evidence": [
          "既有研究稿明确 source、币种、金额精度、JSON 形态和 sports ID 尚未冻结"
        ]
      }
    ],
    "unknowns": [
      "这些合同决定 amount_micros 是否可用、月块编码和历史纠错策略；DDL 当前只能作为字段级建议稿。"
    ]
  },
