{
  "name": "@kando/cardscanfox-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "type-check": "wrangler types && tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "types": "wrangler types",
    "dry-run": "pnpm build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy:preview": "pnpm build && wrangler deploy",
    "content:compile": "node scripts/compile-articles.mjs",
    "release:compare": "node scripts/compare-releases.mjs",
    "catalog:sitemaps": "node scripts/catalog-sitemaps.mjs",
    "build:pages": "node scripts/build.mjs --pages",
    "build:ci": "pnpm build:pages && pnpm test && pnpm type-check && pnpm --filter @kando/website-service test && pnpm --filter @kando/website-service type-check && pnpm --filter @kando/website-service build"
  },
  "dependencies": {
    "@kando/website-content": "workspace:*"
  },
  "devDependencies": {
    "parse5": "8.1.0",
    "wrangler": "4.106.0",
    "typescript": "5.7.2",
    "@types/node": "26.3.0",
    "esbuild": "0.28.2",
    "marked": "15.0.12"
  }
}
