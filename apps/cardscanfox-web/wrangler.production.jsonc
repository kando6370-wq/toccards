{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toccards-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "none"
  },
  "services": [
    {
      "binding": "SITE_DATA",
      "service": "cardscanfox-site-data-preview"
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "DEPLOYMENT_MODE": "production",
    "LOCAL_DEVELOPMENT": "false",
    "PUBLIC_ORIGIN": "https://tcgcard.fun",
    "CATALOG_MODE": "service",
    "PUBLISH_READY": "true"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": []
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "account_id": "dced4adca2f35cff247b39979058b934",
  "routes": [
    {
      "pattern": "tcgcard.fun/*",
      "zone_name": "tcgcard.fun"
    }
  ]
}
