{
  "name": "@kando/workers-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "pnpm run deploy:dry-run:prod && pnpm run deploy:dry-run:dev",
    "build:assets:prod": "pnpm --filter @kando/auth-core build && pnpm --filter @kando/admin-web build:prod",
    "build:assets:dev": "pnpm --filter @kando/auth-core build && pnpm --filter @kando/admin-web build:dev",
    "deploy:dry-run:prod": "pnpm run build:assets:prod && wrangler deploy --env prod --dry-run --outdir dist/prod",
    "deploy:dry-run:dev": "pnpm run build:assets:dev && wrangler deploy --env dev --dry-run --outdir dist/dev",
    "deploy:prod": "pnpm run build:assets:prod && wrangler deploy --env prod",
    "deploy:dev": "pnpm run build:assets:dev && wrangler deploy --env dev",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "admin:init": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@bradford-tech/supabase-integrity-attest": "0.9.1",
    "@kando/auth-core": "workspace:*",
    "drizzle-orm": "^0.38.0",
    "fflate": "^0.8.2",
    "hono": "^4.6.0",
    "i18n-iso-countries": "7.14.0",
    "postgres": "3.4.9",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@electric-sql/pglite": "0.5.7",
    "drizzle-kit": "^0.30.0",
    "miniflare": "4.20260630.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.106.0"
  }
}
