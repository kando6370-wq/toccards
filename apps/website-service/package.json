{
  "name": "@kando/website-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "type-check": "wrangler types && tsc --noEmit",
    "types": "wrangler types",
    "test": "node --test test/*.test.mjs",
    "export:snapshot": "node scripts/export-snapshot.mjs",
    "build:ci": "pnpm test && pnpm type-check && pnpm build",
    "deploy:preview": "wrangler deploy"
  },
  "dependencies": {
    "@kando/website-content": "workspace:*",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "wrangler": "4.106.0",
    "typescript": "5.7.2",
    "@types/node": "26.3.0",
    "esbuild": "0.28.2",
    "@electric-sql/pglite": "0.5.7"
  }
}
